# ==========================================================
# Q6. NEURAL NETWORKS FOR ALL LOGIC GATES
# ==========================================================

X = np.array([
    [0, 0],
    [0, 1],
    [1, 0],
    [1, 1]
])

gates = {
    "AND":  [0, 0, 0, 1],
    "OR":   [0, 1, 1, 1],
    "NAND": [1, 1, 1, 0],
    "NOR":  [1, 0, 0, 0],
    "XOR":  [0, 1, 1, 0],
    "XNOR": [1, 0, 0, 1]
}

for name, output in gates.items():

    y = np.array(output)

    model = MLPClassifier(
        hidden_layer_sizes=(4,),
        activation="tanh",
        solver="lbfgs",
        max_iter=5000,
        random_state=42
    )

    model.fit(X, y)
    y_pred = model.predict(X)

    print("\n", name, "Gate")
    print("Actual Output:", y)
    print("Predicted Output:", y_pred)
    print("Accuracy:", model.score(X, y))

# NOT Gate
X_not = np.array([[0], [1]])
y_not = np.array([1, 0])

not_model = MLPClassifier(
    hidden_layer_sizes=(2,),
    activation="tanh",
    solver="lbfgs",
    max_iter=5000,
    random_state=42
)

not_model.fit(X_not, y_not)

print("\nNOT Gate")
print("Actual Output:", y_not)
print("Predicted Output:", not_model.predict(X_not))
print("Accuracy:", not_model.score(X_not, y_not))


